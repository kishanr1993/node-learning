{
  "info": {
    "_postman_id": "d82f7c4e-9b62-4b3a-86c5-a3d8e5b4c101",
    "name": "Node Learning APIs",
    "description": "Postman Collection for Node.js Express & MongoDB APIs (Auth, Users, Roles, Home)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Home",
      "item": [
        {
          "name": "Health / Home Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Check if the server is up and running"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"johndoe@example.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"user\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new user account. Role can be 'user', 'admin', or omitted (defaults to 'user')."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "        console.log(\"Saved JWT token to collection variables\");",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"johndoe@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticate user and receive a JWT Bearer token (auto-saved to {{token}} variable)."
          },
          "response": []
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Logout user (requires valid Bearer token in Authorization header)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users?page=1&limit=10&search=&status=&sort=createdAt&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page (max: 100)"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Search by user name or email",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "true",
                  "description": "Filter by active status (true/false)",
                  "disabled": true
                },
                {
                  "key": "roleId",
                  "value": "",
                  "description": "Filter by MongoDB Role ObjectId",
                  "disabled": true
                },
                {
                  "key": "sort",
                  "value": "createdAt",
                  "description": "Field to sort by: name, email, createdAt"
                },
                {
                  "key": "order",
                  "value": "desc",
                  "description": "Order: asc or desc"
                }
              ]
            },
            "description": "Fetch paginated users list with search, filter, and sorting."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Get All Roles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/roles?page=1&limit=10&search=&status=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roles"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page (max: 100)"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Search by role name or slug",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "1",
                  "description": "Filter by status (1 or 0)",
                  "disabled": true
                }
              ]
            },
            "description": "Fetch paginated roles list with search and filter."
          },
          "response": []
        }
      ]
    }
  ]
}

